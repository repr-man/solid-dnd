{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsxImportSource": "@solidjs/web"
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__tests__/*"]
}
