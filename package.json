{
  "name": "@thisbeyond/solid-dnd",
  "version": "0.7.5",
  "description": "A lightweight drag and drop toolkit for Solid.",
  "homepage": "https://github.com/thisbeyond/solid-dnd#readme",
  "license": "MIT",
  "author": "Martin Pengelly-Phillips",
  "keywords": [
    "drag and drop",
    "dnd",
    "sortable",
    "reorder",
    "reorderable",
    "solid",
    "solidjs"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {},
  "exports": {
    "solid": {
      "development": {
        "types": "./dist/index.d.ts",
        "import": "./dist/dev.jsx"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.jsx"
      },
      "default": "./dist/index.jsx"
    },
    "development": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/dev.js"
      }
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "default": "./dist/index.js"
  },
  "typesVersions": {},
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "prepublishOnly": "pnpm run build",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisbeyond/solid-dnd.git"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.9",
    "solid-js": "^2.0.0-rc.9"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@solidjs/babel-plugin": "2.0.0-rc.9",
    "@solidjs/signals": "2.0.0-rc.9",
    "@solidjs/web": "2.0.0-rc.9",
    "@release-it/keep-a-changelog": "^3.1.0",
    "prettier": "^2.7.1",
    "release-it": "^15.5.0",
    "solid-js": "2.0.0-rc.9",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@8.6.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.6.0"
  }
}
